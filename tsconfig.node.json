{
  "compilerOptions": {
    "composite": true,
    // A composite project must emit, but its output must NOT land in the repo
    // root: Vite resolves `vite.config.js` *before* `vite.config.ts`, so an
    // emitted sibling would shadow the real config (and the Pages `base` with
    // it) on every subsequent build. Park the emit under node_modules instead.
    "outDir": "./node_modules/.tmp/tsconfig.node",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true
  },
  "include": ["vite.config.ts"]
}
